# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，绝不入库）
# 所有变量都由 src/amr/config.py 的 Settings 读取；业务代码不得直接读环境变量。

# ---------------- 模型供应商（REQ-008）----------------
# 可选：openai（默认） | oneapi | ollama | fake
# fake 为确定性桩模型，仅供离线测试与系统测试使用
AMR_LLM_PROVIDER=openai

# openai：任何 OpenAI 兼容网关
OPENAI_API_BASE=https://api.example.com/v1
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL_NAME=gpt-4o-mini

# oneapi
ONEAPI_API_BASE=http://localhost:3000/v1
ONEAPI_API_KEY=replace-me
ONEAPI_MODEL_NAME=qwen-max

# ollama（本地推理）
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL_NAME=llama3.1:latest

# ---------------- 检索工具 ----------------
SERPER_API_KEY=replace-me

# ---------------- MySQL（作业与事件）----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=amr

# ---------------- Redis（Celery broker）----------------
# 口令填原文即可，代码会用 quote_plus 自动 URL 编码（REQ-009）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------------- 服务与可观测性 ----------------
AMR_API_PORT=8012
# 逗号分隔；默认不是 *（CT-004）
AMR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CREWAI_TRACING_ENABLED=false
AMR_LOG_LEVEL=INFO
