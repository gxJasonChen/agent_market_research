# 密钥与本地配置（绝不入库）
# 用通配而不是逐个列：.env.bak / .env.prod / .env.hidden 这类同样含密钥
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 前端
node_modules/
src/web/dist/
src/web/.vite/
*.tsbuildinfo

# 运行时产物
*.log
logs/
.artifacts/
